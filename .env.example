# Usuário da aplicação: SEM superuser/BYPASSRLS, para o RLS valer de verdade
DATABASE_URL=postgres://app_user:app_user@localhost:5432/allsystems
# Usuário dono do schema, usado só para migrations
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/allsystems

# Bancos de teste (criados pelo docker/postgres/init.sql)
TEST_DATABASE_URL=postgres://app_user:app_user@localhost:5432/allsystems_test
TEST_MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/allsystems_test

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

PORT=3000
ADMIN_URL=http://localhost:5173

# Em dev o Mailpit captura os e-mails (http://localhost:8025). Em produção: SMTP do SES.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="All Systems <nao-responda@allsystems.local>"
