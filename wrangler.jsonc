// Deploy no Cloudflare Workers: admin (assets estáticos) + API Nest (/api/*) + cron (outbox e jobs).
// Segredos (wrangler secret put / painel): JWT_SECRET, SETTINGS_ENCRYPTION_KEY, RESEND_API_KEY e, opcional,
// ANTHROPIC_API_KEY (nota de aderência por IA do Head hunter).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palmer-systems",
  "main": "apps/api/dist/edge.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "class-validator": "./apps/api/edge/missing-optional.cjs",
    "class-transformer": "./apps/api/edge/missing-optional.cjs",
    "@nestjs/websockets/socket-module": "./apps/api/edge/missing-optional.cjs",
    "@nestjs/microservices": "./apps/api/edge/missing-optional.cjs",
    "@nestjs/microservices/microservices-module": "./apps/api/edge/missing-optional.cjs"
  },
  "assets": {
    "directory": "apps/admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Supabase via Hyperdrive (pool de conexões na borda). Criado com cache DESLIGADO:
  // o RLS depende do tenant da transação, e resposta em cache não pode cruzar empresas.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ebd3bfe71f1a413d80fc2295aebfe59b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "palmer-systems-files"
    }
  ],
  // O banco está em us-west-2 e uma requisição faz várias consultas: rodar o Worker perto do
  // banco custa menos que rodar perto do usuário. Os assets do admin continuam saindo da borda.
  // Região fixa: o modo "smart" deixou o Worker em São Paulo (cf-placement: local-GRU), e cada
  // chamada gastava ~2 s só nas idas e voltas até o banco. Se o banco mudar de região, mude aqui.
  "placement": {
    "mode": "targeted",
    "region": "aws:us-west-2"
  },
  // Boot do Nest num isolate novo e argon2id em JS puro passam de centenas de ms de CPU.
  // Exige o Workers Paid: no plano grátis o deploy recusa esta opção.
  "limits": {
    "cpu_ms": 30000
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "NODE_ENV": "production",
    "ADMIN_URL": "https://palmer-systems.all-systems.workers.dev",
    "MAIL_FROM": "Palmer Tech <nao-responda@palmertech.local>"
  },
  "observability": {
    "enabled": true
  }
}
