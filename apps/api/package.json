{
  "name": "@all/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "concurrently -k -n tsc,api,worker \"tsc -b -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\" \"node --env-file-if-exists=../../.env --watch dist/worker.js\"",
    "start": "node dist/main.js",
    "cli": "node --env-file-if-exists=../../.env dist/cli.js",
    "test": "vitest run",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@all/core": "workspace:*",
    "@all/db": "workspace:*",
    "@all/laundry": "workspace:*",
    "@all/module-sdk": "workspace:*",
    "@all/notifications": "workspace:*",
    "@all/service-orders": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.11.29",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.0",
    "supertest": "^7.1.1",
    "unplugin-swc": "^1.5.4",
    "vitest": "^3.2.0"
  }
}
