{
  "name": "@all/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "concurrently -k -n tsc,api,worker \"tsc -b -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\" \"node --env-file-if-exists=../../.env --watch dist/worker.js\"",
    "start": "node dist/main.js",
    "cli": "node --env-file-if-exists=../../.env dist/cli.js",
    "test": "vitest run",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@all/accounting": "workspace:*",
    "@all/aesthetics": "workspace:*",
    "@all/bakery": "workspace:*",
    "@all/banking": "workspace:*",
    "@all/beauty": "workspace:*",
    "@all/consortium": "workspace:*",
    "@all/core": "workspace:*",
    "@all/credit-bureau": "workspace:*",
    "@all/db": "workspace:*",
    "@all/fiscal": "workspace:*",
    "@all/hr": "workspace:*",
    "@all/hr-consulting": "workspace:*",
    "@all/laundry": "workspace:*",
    "@all/legal": "workspace:*",
    "@all/medical-records": "workspace:*",
    "@all/module-sdk": "workspace:*",
    "@all/notifications": "workspace:*",
    "@all/orthodontics": "workspace:*",
    "@all/payments": "workspace:*",
    "@all/pets": "workspace:*",
    "@all/petshop": "workspace:*",
    "@all/realestate": "workspace:*",
    "@all/recruiting": "workspace:*",
    "@all/sales": "workspace:*",
    "@all/scheduling": "workspace:*",
    "@all/service-orders": "workspace:*",
    "@all/store": "workspace:*",
    "@all/vehicles": "workspace:*",
    "@all/vet": "workspace:*",
    "@all/whatsapp": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
